{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "alethia-starter values",
  "description": "The chart's interface. A change here is a MAJOR bump of the chart version: a clone that set a key this schema stopped accepting no longer renders at all.",
  "type": "object",
  "additionalProperties": false,
  "required": ["replicaCount", "image", "page", "service", "serviceAccount", "resources"],
  "properties": {
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "replicaCount": { "type": "integer", "minimum": 0 },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "message": { "type": "string" }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "type": "object" },
        "host": { "type": "string" },
        "path": { "type": "string" },
        "pathType": { "enum": ["Prefix", "Exact", "ImplementationSpecific"] },
        "tls": { "type": "array" }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "description": "create stays false: Alethia's bring-your-own-chart project blacklists ServiceAccount, Role and RoleBinding.",
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": { "type": "object" },
        "limits": { "type": "object" }
      }
    },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" },
    "podAnnotations": { "type": "object" }
  }
}
